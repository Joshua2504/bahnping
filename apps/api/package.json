    "@fastify/websocket": "^11.0.0",
    "altcha-lib": "^1.2.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.3.0",
    "h3-js": "^4.2.0",
    "nodemailer": "^7.0.0",
    "postgres": "^3.4.0",
    "ws": "^8.22.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
