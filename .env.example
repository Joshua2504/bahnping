# Kopieren nach .env – nur Entwicklungs-/Testwerte
NODE_ENV=development
PORT=4100
HOST=0.0.0.0
PUBLIC_URL=http://localhost:4100
DATABASE_URL=postgres://bahn:bahn@127.0.0.1:4132/bahn
SMTP_HOST=127.0.0.1
SMTP_PORT=4125
MAIL_FROM="Bahn-Netzwerk-Tracker <noreply@bahn-tracker.local>"
MAILPIT_UPSTREAM=http://127.0.0.1:4126
# 32+ Zeichen Zufall; wird für Sessions-Hashing-Salt, ALTCHA-HMAC und whoami-Signatur abgeleitet
APP_SECRET=dev-only-change-me-dev-only-change-me-0123456789
# Proxy-Header vertrauen (X-Forwarded-For) – nur wenn ein Reverse Proxy davor steht
TRUST_PROXY=false
# Mindestanzahl verschiedener Fahrten, bevor eine Zelle öffentlich erscheint (Prod: 3)
PUBLIC_MIN_TRIPS=1
# ASN-Datenbank (iptoasn.com, Public Domain). Leer lassen = kein Download (nur Overrides)
IPTOASN_URL=https://iptoasn.com/data/ip2asn-combined.tsv.gz
IPTOASN_CACHE=.run/ip2asn-combined.tsv.gz
# Zusätzliche ASN→Klasse-Zuordnungen, z.B. "12345:db_wlan,67890:mobile_other"
NETCLASS_OVERRIDES=
# Statisches Web-Build, das die API ausliefert (leer = nicht ausliefern)
WEB_DIST=../web/build
# Kachelverzeichnis (PMTiles, Fonts, Sprites)
TILES_DIR=../../infra/tiles/data
